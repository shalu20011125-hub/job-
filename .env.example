# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# PostgreSQL Database Connection URL (e.g., local PostgreSQL or Supabase / Neon / Cloud SQL)
# If left empty, NexusHire automatically runs with its built-in in-memory PostgreSQL engine.
DATABASE_URL="postgres://postgres:your_password@localhost:5432/nexushire_db"
